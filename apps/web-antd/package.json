{
  "name": "@vben/web-antd",
  "version": "5.5.9",
  "homepage": "https://vben.pro",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "apps/web-antd"
  },
  "license": "MIT",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm vite build --mode production",
    "build:analyze": "pnpm vite build --mode analyze",
    "dev": "pnpm vite --mode development",
    "preview": "vite preview",
    "test:e2e": "pnpm typecheck:e2e && pnpm build && (receipt_dir=$(mktemp -d) && trap 'rm -rf \"$receipt_dir\"' EXIT && cargo run --locked --manifest-path ../../../Cargo.toml --target-dir ../../../target/e2e -p ng-gateway-xtask -- build --profile release --no-deploy --ui-dist-dir ng-gateway-ui/apps/web-antd/dist --ui-out-dir target/e2e-ui --cohort-path-file \"$receipt_dir/cohort\" -- --locked --target-dir target/e2e && IFS= read -r cohort < \"$receipt_dir/cohort\" && NG_TEST_NATIVE_ARTIFACT_DIR=\"${NG_TEST_NATIVE_ARTIFACT_DIR-$cohort}\" playwright test)",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@vben-core/composables": "workspace:*",
    "@vben-core/shadcn-ui": "workspace:*",
    "@vben-core/shared": "workspace:*",
    "@vben/access": "workspace:*",
    "@vben/common-ui": "workspace:*",
    "@vben/constants": "workspace:*",
    "@vben/hooks": "workspace:*",
    "@vben/icons": "workspace:*",
    "@vben/layouts": "workspace:*",
    "@vben/locales": "workspace:*",
    "@vben/plugins": "workspace:*",
    "@vben/preferences": "workspace:*",
    "@vben/request": "workspace:*",
    "@vben/stores": "workspace:*",
    "@vben/styles": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "ant-design-vue": "catalog:",
    "awesome-phonenumber": "catalog:",
    "country-state-city": "catalog:",
    "dayjs": "catalog:",
    "json-editor-vue": "catalog:",
    "pinia": "catalog:",
    "vanilla-jsoneditor": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tel-input": "catalog:"
  }
}
